# --- Python ---
**/__pycache__/
__pycache__/
*.py[cod]
*.pyo
*$py.class
*.so
*.pyd

# --- Entornos virtuales ---
.venv/
venv/
env/
.env
ENV/

# --- Distribucion / packaging ---
build/
dist/
*.egg-info/
*.egg
*.whl
.eggs/
develop-eggs/
sdist/
wheels/
pip-wheel-metadata/
.installed.cfg
MANIFEST

# --- uv ---
# uv.lock SÍ se commitea. Esto no es una librería: es un proyecto de datos, y
# el lock es lo único que hace reproducible el entorno entre tu máquina, la de
# tu compañero y CI. Además el workflow hace `uv sync --frozen`, que falla con
# «Unable to find lockfile» si el lock no viaja en el repositorio.

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Tests / coverage ---
.tox/
.coverage
.coverage.*
.cache/
.hypothesis/
htmlcov/
coverage.xml
nosetests.xml
.pytest_cache/

# --- Datos - ignorar archivos, conservar estructura de carpetas ---
data/**/*.csv
data/**/*.tsv
data/**/*.json
data/**/*.jsonl
data/**/*.parquet
data/**/*.feather
data/**/*.pkl
data/**/*.pickle
data/**/*.h5
data/**/*.hdf5
data/**/*.xlsx
data/**/*.xls
data/**/*.zip
data/**/*.tar.gz
data/**/*.gz
data/**/*.db
data/**/*.sqlite
data/**/*.sqlite3
!data/**/.gitkeep

# --- Reportes / figuras generadas ---
reports/figures/*.png
reports/figures/*.pdf
reports/figures/*.svg
reports/**/*.csv
*.html
!docs/**/*.html
# La interfaz del chat es código fuente del template, no un informe generado:
# sin esta excepción `*.html` se la traga y el proyecto nace sin UI.
!chat/static/*.html
# La demo es código fuente estático (páginas de la web GitHub Pages), no un
# informe generado: sin esta excepción `*.html` se traga index/try/docs/mcp.
!demo/**/*.html

# --- Modelos entrenados ---
models/**/*.joblib
models/**/*.pkl
models/**/*.pt
models/**/*.pth
models/**/*.onnx
!models/**/.gitkeep

# Los ONNX de la demo SÍ se commitean: son pequeños (KB a pocos MB) y viajan
# como archivos normales del repo para la demo web.
!demo/**/*.onnx
!demo/**/meta.json

# --- Artefactos ML ---
artifacts/**/*.joblib
artifacts/**/*.pkl
!artifacts/**/.gitkeep

# MLflow
mlruns/
mlartifacts/

# TensorBoard
runs/

# --- Copier ---
!.copier-answers.yml

# --- IDEs ---
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
*.sublime-project
*.sublime-workspace

# --- Sistema operativo ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# --- Logs ---
*.log
logs/

# --- Secretos / credenciales ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Sphinx ---
docs/_build/

# --- Graphify ---
graphify-out/

# --- OpenCode skills (generados por make skills) ---
.opencode/skills/

# --- RAG index (base de datos vectorial ChromaDB) ---
.rag-index/

